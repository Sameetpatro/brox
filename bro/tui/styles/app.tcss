/* Bro TUI — Main Textual CSS Theme */
/* Modern, dark, vibrant design system */

/* ─── Global ─────────────────────────────────────────── */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ─── Header / Footer ────────────────────────────────── */

Header {
    background: #161b22;
    color: #58a6ff;
    dock: top;
    height: 3;
}

Footer {
    background: #161b22;
    color: #8b949e;
}

/* ─── Panels ─────────────────────────────────────────── */

.panel {
    border: round #30363d;
    background: #161b22;
    padding: 1 2;
    margin: 1 2;
}

.panel-title {
    text-style: bold;
    color: #58a6ff;
    text-align: center;
    padding: 1 0;
}

/* ─── Buttons ────────────────────────────────────────── */

Button {
    background: #21262d;
    color: #e6edf3;
    border: tall #30363d;
    min-width: 16;
    height: 3;
    margin: 0 1;
}

Button:hover {
    background: #30363d;
    color: #58a6ff;
    border: tall #58a6ff;
}

Button:focus {
    background: #1f6feb;
    color: #ffffff;
    border: tall #58a6ff;
    text-style: bold;
}

Button.-primary {
    background: #1f6feb;
    color: #ffffff;
    border: tall #388bfd;
}

Button.-primary:hover {
    background: #388bfd;
}

Button.-success {
    background: #238636;
    color: #ffffff;
    border: tall #2ea043;
}

Button.-success:hover {
    background: #2ea043;
}

Button.-danger {
    background: #da3633;
    color: #ffffff;
    border: tall #f85149;
}

Button.-danger:hover {
    background: #f85149;
}

/* ─── Input ──────────────────────────────────────────── */

Input {
    background: #0d1117;
    color: #e6edf3;
    border: tall #30363d;
    padding: 0 2;
    height: 3;
}

Input:focus {
    border: tall #58a6ff;
}

/* ─── Selection List / Options ───────────────────────── */

SelectionList {
    background: #0d1117;
    border: round #30363d;
    padding: 1;
    height: auto;
    max-height: 20;
}

OptionList {
    background: #0d1117;
    border: round #30363d;
    padding: 1;
    height: auto;
    max-height: 16;
}

OptionList > .option-list--option-highlighted {
    background: #1f6feb;
    color: #ffffff;
}

/* ─── Language Cards ─────────────────────────────────── */

.language-card {
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin: 0 1 1 0;
    min-width: 20;
    height: 5;
    content-align: center middle;
}

.language-card:hover {
    border: round #58a6ff;
    background: #1c2128;
}

.language-card.-selected {
    border: round #58a6ff;
    background: #0d419d;
}

/* ─── Feature Toggles ────────────────────────────────── */

.feature-item {
    height: 3;
    padding: 0 2;
    margin: 0 0 0 0;
}

.feature-item:hover {
    background: #1c2128;
}

.feature-label {
    color: #e6edf3;
    padding: 0 1;
}

.feature-description {
    color: #8b949e;
    text-style: italic;
}

/* ─── Progress ───────────────────────────────────────── */

ProgressBar {
    padding: 1 2;
}

ProgressBar Bar {
    color: #1f6feb;
    background: #21262d;
}

ProgressBar PercentageStatus {
    color: #58a6ff;
    text-style: bold;
}

/* ─── Step Indicator ─────────────────────────────────── */

.step-indicator {
    dock: top;
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 1 2;
    text-align: center;
}

.step-active {
    color: #58a6ff;
    text-style: bold;
}

.step-done {
    color: #3fb950;
}

.step-pending {
    color: #484f58;
}

/* ─── Summary Panel ──────────────────────────────────── */

.summary-panel {
    background: #161b22;
    border: round #30363d;
    padding: 2 3;
    margin: 1 2;
}

.summary-key {
    color: #8b949e;
    min-width: 20;
}

.summary-value {
    color: #e6edf3;
    text-style: bold;
}

/* ─── AI Menu ────────────────────────────────────────── */

.ai-menu-item {
    background: #161b22;
    border: round #30363d;
    padding: 2 3;
    margin: 1 2;
    height: 7;
}

.ai-menu-item:hover {
    border: round #58a6ff;
    background: #1c2128;
}

.ai-menu-item:focus {
    border: round #1f6feb;
    background: #0d419d;
}

/* ─── Scrollbar ──────────────────────────────────────── */

Scrollbar {
    background: #161b22;
}

ScrollBar > .scrollbar--bar {
    color: #30363d;
}

ScrollBar > .scrollbar--bar:hover {
    color: #484f58;
}

/* ─── Tabs ───────────────────────────────────────────── */

TabbedContent {
    background: #0d1117;
}

Tab {
    background: #161b22;
    color: #8b949e;
    padding: 1 3;
}

Tab:hover {
    color: #e6edf3;
}

Tab.-active {
    color: #58a6ff;
    text-style: bold;
    border-bottom: solid #58a6ff;
}

/* ─── Misc ───────────────────────────────────────────── */

.title-text {
    color: #58a6ff;
    text-style: bold;
    text-align: center;
    padding: 1 0;
}

.subtitle-text {
    color: #8b949e;
    text-align: center;
    padding: 0 0 1 0;
}

.muted {
    color: #484f58;
}

.highlight {
    color: #f0883e;
    text-style: bold;
}

.success-text {
    color: #3fb950;
    text-style: bold;
}

.error-text {
    color: #f85149;
    text-style: bold;
}

/* ─── Navigation Bar ─────────────────────────────────── */

.nav-bar {
    dock: bottom;
    height: 3;
    background: #161b22;
    border-top: solid #30363d;
    padding: 0 2;
    layout: horizontal;
    align: center middle;
}
