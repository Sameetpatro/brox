[package]
name = "{{ project_name_safe }}"
version = "0.1.0"
edition = "2021"

[dependencies]
actix-web = "4"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
{% if has_postgresql %}
sqlx = { version = "0.7", features = ["runtime-tokio-rustls", "postgres"] }
{% endif %}
{% if has_redis %}
redis = { version = "0.25", features = ["tokio-comp"] }
{% endif %}
{% if has_jwt %}
jsonwebtoken = "9"
{% endif %}
